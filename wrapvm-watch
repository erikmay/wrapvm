function link(m){return `http://127.0.0.1:${m.port}/?token=${encodeURIComponent(m.token)}`}
function status(m){
  if(m.state!=='running')return['off','stopped'];
  if(m.up)return['ok','desktop up'];
  return m.down_for>=0?['bad',`desktop down ${m.down_for}s`]:['warn','starting'];
}
function card(m){
  let c=cards[m.name];
  if(!c){
