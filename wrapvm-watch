class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        # Pages on other sites must not read this one (it holds viewer passwords).
        host_hdr = self.headers.get("Host", "")
        if host_hdr.split(":")[0] not in ("127.0.0.1", "localhost", "[::1]"):
            return self.send(403, b"forbidden\n", "text/plain")
        path = self.path.split("?")[0]
        if path == "/":
            return self.send(200, PAGE.encode(), "text/html; charset=utf-8")
        if path == "/api/machines":
            with lock:
                body = {"machines": sorted(machines.values(), key=lambda m: (m["state"] != "running", m["name"])),
                        "host": dict(host)}
            return self.send(200, json.dumps(body).encode(), "application/json")
        if path.startswith("/shot/"):
            name = urllib.request.unquote(path[len("/shot/"):])
            with lock:
                m = dict(machines.get(name) or {})
            if not m.get("up") or not m.get("token"):
                return self.send(404, b"", "text/plain")
            auth = base64.b64encode(f":{m['token']}".encode()).decode()
            req = urllib.request.Request(f"http://127.0.0.1:{m['port']}/screenshot", headers={"Authorization": f"Basic {auth}"})
            try:
                with urllib.request.urlopen(req, timeout=3) as r:
                    return self.send(200, r.read(), "image/png")
            except (urllib.error.URLError, OSError):
                return self.send(502, b"", "text/plain")
        return self.send(404, b"not found\n", "text/plain")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


LABEL = "dev.wrapvm.watch"
PLIST = os.path.expanduser(f"~/Library/LaunchAgents/{LABEL}.plist")


def launchctl(*args):
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


def install():
    import plistlib
    import shutil
    smolvm = shutil.which(SMOLVM)
    if not smolvm:
        sys.exit(f"wrapvm-watch: {SMOLVM} is not on PATH")
    env = {"PATH": f"{os.path.dirname(smolvm)}:/usr/bin:/bin:/usr/sbin:/sbin"}
    for k in ("WRAPVM_WATCH_PORT", "WRAPVM_WATCH_HEAL_SECONDS", "SMOLVM"):
        if k in os.environ:
            env[k] = os.environ[k]
    log = os.path.expanduser("~/Library/Logs/wrapvm-watch.log")
    plist = {
        "Label": LABEL,
        "ProgramArguments": [sys.executable, os.path.abspath(__file__)],
        "EnvironmentVariables": env,
        "RunAtLoad": True,
        "KeepAlive": True,
        "StandardOutPath": log,
        "StandardErrorPath": log,
    }
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    with open(PLIST, "wb") as f:
        plistlib.dump(plist, f)
    r = launchctl("bootstrap", f"gui/{os.getuid()}", PLIST)
    if r.returncode != 0:
        sys.exit(f"wrapvm-watch: launchctl bootstrap failed: {r.stderr.strip()}")
    print(f"wrapvm-watch: installed ({PLIST}); http://127.0.0.1:{PORT}/, log {log}")


def uninstall():
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    if os.path.exists(PLIST):
        os.remove(PLIST)
    print("wrapvm-watch: uninstalled")


def main():
    if sys.argv[1:] == ["--install"]:
        return install()
    if sys.argv[1:] == ["--uninstall"]:
        return uninstall()
    if sys.argv[1:]:
        sys.exit("usage: wrapvm-watch [--install | --uninstall]")
    threading.Thread(target=poll, daemon=True).start()
    srv = Server((LISTEN, PORT), Handler)
    print(f"wrapvm-watch: http://127.0.0.1:{PORT}/", file=sys.stderr)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
