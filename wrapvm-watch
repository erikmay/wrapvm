#!/usr/bin/env python3
"""wrapvm-watch: one local web page that shows every wrapvm machine's desktop.

    ./wrapvm-watch                 # http://127.0.0.1:6060/
    WRAPVM_WATCH_PORT=7000 ./wrapvm-watch

The page lists every smolvm machine that runs the wrapvm desktop, with a live
picture of its screen (the viewer's /screenshot, a few times a second), its
state, guest memory and CPU, and the host memory its VM process holds. A click
on a tile opens that desktop's interactive viewer (voxl) in the page; the
viewer's password stays in this process and in the page, both on loopback.

It is also a watchdog: a running machine whose viewer stops answering is
marked down, and after WRAPVM_WATCH_HEAL_SECONDS (default 30, 0 turns it off)
`wrap-desktop start` is run in it, which brings the desktop back.

Only the Python standard library and the smolvm CLI ($SMOLVM) are used.

On macOS, `./wrapvm-watch --install` runs it as a LaunchAgent: it starts at
login and comes back if it exits (log: ~/Library/Logs/wrapvm-watch.log).
`./wrapvm-watch --uninstall` removes it. The agent runs this file where it is.
"""
import base64
import http.server
import json
import os
import re
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

SMOLVM = os.environ.get("SMOLVM", "smolvm")
LISTEN = os.environ.get("WRAPVM_WATCH_ADDR", "127.0.0.1")
PORT = int(os.environ.get("WRAPVM_WATCH_PORT", "6060"))
HEAL_SECONDS = int(os.environ.get("WRAPVM_WATCH_HEAL_SECONDS", "30"))
VIEWER_GUEST_PORT = 6080

lock = threading.Lock()
machines = {}       # name -> dict shown on the page
passwords = {}      # (name, pid) -> viewer password
down_since = {}     # name -> monotonic time the viewer was first seen down
host = {}


def run(*args, timeout=10):
    try:
        p = subprocess.run([SMOLVM, *args], capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (subprocess.TimeoutExpired, OSError):
        return 1, ""


def machine_config(name):
    """Host port of the viewer and the workspace mount, from the machine's data dir."""
    rc, out = run("machine", "data-dir", "--name", name)
    if rc != 0:
        return None, None
    try:
        with open(os.path.join(out.strip(), "agent.config.json")) as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return None, None
    port = next((p["host"] for p in cfg.get("ports", []) if p.get("guest") == VIEWER_GUEST_PORT), None)
    mount = next((m["source"] for m in cfg.get("mounts", []) if m.get("target") == "/home/user/workspace"), None)
    return port, mount


def is_wrapvm(m):
    labels = m.get("labels") or {}
    return "wrapvm" in labels or "wrap-desktop" in " ".join(m.get("cmd") or [])


def viewer_password(name, pid):
    key = (name, pid)
    if key not in passwords:
        rc, out = run("machine", "exec", "--name", name, "-u", "user", "--", "wrap-desktop", "password")
        if rc != 0 or not out.strip():
            return None
        passwords[key] = out.strip()
    return passwords[key]


def viewer_up(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/healthz", timeout=1) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def guest_stats(name):
    rc, out = run("machine", "stats", "--name", name, timeout=5)
    s = {}
    m = re.search(r"cpu: ([\d.]+)% of (\d+)%", out)
    if m:
        s["cpu"] = float(m.group(1)) / 100   # in cores
    m = re.search(r"memory: ([\d.]+) GiB of ([\d.]+) GiB", out)
    if m:
        s["mem_used"], s["mem_total"] = float(m.group(1)), float(m.group(2))
    return s


def host_rss_gib(pid):
    try:
        out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)], capture_output=True, text=True).stdout
        return int(out.strip()) / 1048576
    except (ValueError, OSError):
        return None


def host_memory():
    h = {}
    try:
        h["total"] = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout) / 2**30
        out = subprocess.run(["memory_pressure"], capture_output=True, text=True).stdout
        m = re.search(r"free percentage: (\d+)%", out)
        if m:
            h["free_pct"] = int(m.group(1))
    except (ValueError, OSError):
        pass
    return h


def heal(name):
    run("machine", "exec", "--name", name, "-u", "user", "--", "wrap-desktop", "start", timeout=120)


def poll():
    tick = 0
    while True:
        rc, out = run("machine", "ls", "--json")
        try:
            listed = json.loads(out) if rc == 0 else []
        except ValueError:
            listed = []
        seen = {}
        for m in listed:
            if not is_wrapvm(m):
                continue
            name, running, pid = m["name"], m.get("state") == "running", m.get("pid")
            port, mount = machine_config(name)
            labels = m.get("labels") or {}
            if labels.get("wrapvm.port"):
                port = int(labels["wrapvm.port"])
            entry = {
                "name": name,
                "state": m.get("state"),
                "dir": labels.get("wrapvm.dir") or mount,
                "port": port,
                "cpus": m.get("cpus"),
                "image": m.get("image"),
                "up": False,
                "token": None,
            }
            prev = machines.get(name, {})
            if running and port:
                entry["up"] = viewer_up(port)
                if entry["up"]:
                    entry["token"] = viewer_password(name, pid)
                    down_since.pop(name, None)
                else:
                    first = down_since.setdefault(name, time.monotonic())
                    entry["down_for"] = int(time.monotonic() - first)
                    if HEAL_SECONDS and entry["down_for"] >= HEAL_SECONDS:
                        print(f"wrapvm-watch: {name}: viewer down {entry['down_for']}s, running wrap-desktop start", file=sys.stderr)
                        down_since[name] = time.monotonic() + 60   # one try per ~90s
                        threading.Thread(target=heal, args=(name,), daemon=True).start()
                if tick % 3 == 0:
                    entry.update(guest_stats(name))
                    entry["host_rss"] = host_rss_gib(pid) if pid else None
                else:
                    for k in ("cpu", "mem_used", "mem_total", "host_rss"):
                        if k in prev:
                            entry[k] = prev[k]
            seen[name] = entry
        with lock:
            machines.clear()
            machines.update(seen)
            if tick % 3 == 0:
                host.update(host_memory())
        tick += 1
        time.sleep(2)


