  ms.forEach(m=>grid.appendChild(card(m)));
}
async function refresh(){try{data=await (await fetch('/api/machines')).json();render()}catch(e){}}
// Screenshots: one request in flight per tile, ~3 per second, paused while a desktop is open full size.
