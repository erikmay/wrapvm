#!/bin/sh
# wrap's workflow on smolvm, using the Smolfile next to this script.
#   wrapvm            this directory's machine, in its tmux session `main`
#                     (detach with Ctrl-b d; WRAPVM_TMUX=0 gives a plain zsh)
#   wrapvm -- CMD...  run CMD there
# Before either, the project's .agents/setup and .agents/resume run when due
# (see wrap-hooks in the Containerfile; WRAPVM_HOOKS=0 skips them).
# The desktop viewer (voxl) is published on the host's loopback at a port chosen
# when the machine is created: $WRAPVM_DESKTOP_PORT, else the first port from
# 6080 up that no other machine holds and nothing listens on. The sign-in link
# is printed on every start. `wrapvm-watch` shows every machine on one page.
# SMOLVM (default smolvm) names the smolvm CLI; WRAPVM_IMAGE overrides the
# Smolfile's image when the machine is created (a registry ref or ./image.tar).
# WRAP_DESKTOP_VOXL_ARGS, set at create, reaches the viewer (e.g.
# --allowed-hosts=NAME behind an HTTPS proxy such as tailscale serve).
set -eu
here=$(dirname "$(readlink -f "$0")")
smolvm="${SMOLVM:-smolvm}"
dir=$(pwd -P)
base=$(basename "$dir" | tr -cs 'A-Za-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//')
name="${base:-wrapvm}-$(printf %s "$dir" | cksum | cut -c1-6)"

# The host port a machine publishes the viewer (guest 6080) on: its
# wrapvm.port label, set at create (kept while stopped), else, for a machine
# made before the label, the running machine's configuration in its data dir.
machine_port() {
  p=$("$smolvm" machine status --name "$1" --json 2>/dev/null \
    | sed -n 's/^ *"wrapvm\.port": "\([0-9]*\)",*$/\1/p' | head -n 1)
  if [ -z "$p" ] && d=$("$smolvm" machine data-dir --name "$1" 2>/dev/null); then
    p=$(sed -n 's/.*"host":\([0-9]*\),"guest":6080.*/\1/p' "$d/agent.config.json" 2>/dev/null | head -n 1)
  fi
  echo "$p"
}

# A port for a new machine: one no machine holds, running or stopped, and
# nothing on this host listens on.
free_port() {
  held=" "
  for m in $("$smolvm" machine ls --json 2>/dev/null | sed -n 's/^ *"name": "\(.*\)",$/\1/p'); do
    held="$held$(machine_port "$m") "
  done
  p=6080
  while case "$held" in *" $p "*) true ;; *) nc -z 127.0.0.1 "$p" 2>/dev/null ;; esac; do
    p=$((p + 1))
  done
  echo "$p"
}

# One machine per directory; it mounts the directory it was created from.
if "$smolvm" machine status --name "$name" >/dev/null 2>&1; then
  port=$(machine_port "$name")
  port="${port:-${WRAPVM_DESKTOP_PORT:-6080}}"
else
  port="${WRAPVM_DESKTOP_PORT:-$(free_port)}"
  ( # a subshell, so the caller's arguments survive
    # WRAP_UID/WRAP_GID: the Smolfile's init gives the guest `user` these ids,
    # so the workspace mount (owned by this host user) is writable in the guest.
    set -- machine create --name "$name" -s "$here/Smolfile" -p "$port:6080" \
      -e "WRAP_UID=$(id -u)" -e "WRAP_GID=$(id -g)" \
      --label wrapvm=1 --label "wrapvm.dir=$dir" --label "wrapvm.port=$port"
    [ -z "${WRAPVM_IMAGE:-}" ] || set -- "$@" --image "$WRAPVM_IMAGE"
    [ -z "${WRAP_DESKTOP_VOXL_ARGS:-}" ] || set -- "$@" -e "WRAP_DESKTOP_VOXL_ARGS=$WRAP_DESKTOP_VOXL_ARGS"
    exec "$smolvm" "$@" >/dev/null
  )
fi

# Credentials are read from this environment when the machine starts
# (a no-op when it is already running): GitHub from gh, claude's ANTHROPIC_API_KEY as is.
if token=$(gh auth token 2>/dev/null) && [ -n "$token" ]; then
  GH_TOKEN="Basic $(printf 'x-access-token:%s' "$token" | base64 | tr -d '\n')"
  export GH_TOKEN
fi
"$smolvm" machine start --name "$name" >&2

# The viewer's password is made up on the desktop's first start: wait for it.
i=0
until link=$("$smolvm" machine exec --name "$name" -u user -- wrap-desktop url "127.0.0.1:$port" 2>/dev/null); do
  i=$((i + 1)); [ "$i" -lt 60 ] || { link="(not up yet: wrapvm -- wrap-desktop url 127.0.0.1:$port)"; break; }
  sleep 1
done
echo "desktop: $link" >&2

# The project's hooks, when it has them: .agents/setup once per machine (and
# when the file changes), .agents/resume once per boot. WRAPVM_HOOKS=0 skips
# them. An image from before wrap-hooks has none to run.
if [ "${WRAPVM_HOOKS:-1}" != 0 ]; then
  "$smolvm" machine exec --name "$name" -u user -- \
    bash -lc '[ ! -x /opt/wrap/bin/wrap-hooks ] || exec /opt/wrap/bin/wrap-hooks' </dev/null >&2 || true
fi

[ "${1:-}" = "--" ] && shift
t=; [ -t 0 ] && [ -t 1 ] && t=-t
if [ $# -eq 0 ]; then
  if [ -n "$t" ] && [ "${WRAPVM_TMUX:-1}" != 0 ]; then
    # tmux session `main`: made on the first run, attached to on later ones, so
    # what runs in it survives a closed terminal. zsh where the image has no tmux.
    set -- sh -c 'command -v tmux >/dev/null && exec tmux new-session -A -s main; exec zsh -l'
  else
    set -- zsh -l
  fi
fi
exec "$smolvm" machine exec --name "$name" -u user -i $t -- "$@"
